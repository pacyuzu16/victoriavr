# Copy this file to .env and fill in your key, then run `npm run server`.
# .env is git-ignored — never commit real keys.

# Required for the optional "Claude" brain (real tool-calling via the local proxy).
# Get one at https://console.anthropic.com/ . The browser never sees this key —
# it stays on the local proxy in server/index.mjs.
ANTHROPIC_API_KEY=

# Optional. Model for the Claude brain. Default: claude-opus-5.
# Set to claude-haiku-4-5 for lowest latency.
# ANIMA_MODEL=claude-opus-5

# Optional. Port for the local proxy (Vite proxies /api to it). Default: 8787.
# ANIMA_PORT=8787
